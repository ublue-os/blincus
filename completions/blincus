# bash completion for blincus
_blincus() {
	local cur=${COMP_WORDS[COMP_CWORD]}
	if [[ $COMP_CWORD -eq 1 ]]; then
		mapfile -t COMPREPLY < <(compgen -W "enter ls rm --help --version" -- "$cur")
		return
	fi
	case ${COMP_WORDS[1]} in
	rm)
		local names
		names=$(incus ls --format json 2>/dev/null |
			jq -r '.[] | select(.config."user.blincus.project") | .name')
		mapfile -t COMPREPLY < <(compgen -W "$names" -- "$cur")
		;;
	enter)
		mapfile -t COMPREPLY < <(compgen -W "-i --image" -- "$cur")
		;;
	esac
}
complete -F _blincus blincus

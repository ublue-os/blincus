#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"

BIN_DIR="${BIN_DIR:-$HOME/.local/bin}"
COMP_DIR="${COMP_DIR:-$HOME/.local/share/bash-completion/completions}"

install -D -m 0755 blincus "$BIN_DIR/blincus"
install -D -m 0644 completions/blincus "$COMP_DIR/blincus"

echo "Installed blincus to $BIN_DIR/blincus"
[[ ":$PATH:" == *":$BIN_DIR:"* ]] || echo "note: $BIN_DIR is not on your PATH"
